# Supabase PostgreSQL connection used by the application at runtime.
# Copy the Session Pooler URI from Supabase if your environment requires pooling.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct Supabase PostgreSQL URI for Prisma migrations and the seed.
# If omitted, DATABASE_URL is used instead.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Generate different random secrets for access and refresh tokens.
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
